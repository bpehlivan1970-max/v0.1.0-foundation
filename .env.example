# Credentials: set ANTHROPIC_API_KEY, or run `ant auth login` instead.
ANTHROPIC_API_KEY=
# Optional overrides
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium          # low | medium | high | xhigh | max
CLAUDE_MAX_TOKENS=64000
CLAUDE_SHOW_THINKING=0        # 1 = stream summarized reasoning
CLAUDE_USE_FALLBACKS=1        # 0 = disable server-side refusal fallback
